* Defines "inpbc" selection, which selects all atoms located within regions
* reserved for periodic components or for a membrane.
*
if @?IN2 .eq. 0 set IN2 = none
if IN1 .eq. exclude then
    define inpbc select none end
    if IN2 .eq. nomembrane then
        return
    endif
    define inpbc select inpbc .or. ( prop Z .ge. -20.00 .and. prop Z .le.  20.00 ) end
    return
endif

define inpbc select none end
if IN2 .eq. nomembrane then
    return
endif

define inpbc select inpbc .or. ( prop Z .ge. -20.00 .and. prop Z .le.  20.00 ) end

