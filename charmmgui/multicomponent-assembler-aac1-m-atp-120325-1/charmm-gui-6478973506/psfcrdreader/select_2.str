* Defines "target" selection, which selects all atoms which originated from
* this PSF. First argument restricts selection to the given copy number.
* Use "*" to select all copies.
* Original PSF: step1_pdbreader.psf
*

define target select none end
define target select target .or. segid HAB@IN1 end
define target select target .or. segid PAA@IN1 end
