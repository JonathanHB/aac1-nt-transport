* Defines pbc variables containing position and length of XY periodic and
* membrane exclusion regions.
* Usage: stream polinfo/define_pbc.str
*

calc pbczpos1   =   0.00 ! Z center of periodic component 0
calc pbczlen1   =  40.00 ! component thickness
calc pbczlenex1 =  40.00 ! total excluded width
calc pbcztop1   =  20.00 ! top of component
calc pbczbot1   = -20.00 ! bottom of component
calc pbcztopex1 =  20.00 ! top of excluded region
calc pbczbotex1 = -20.00 ! bottom of excluded region

calc npbcz     =   1 ! includes membrane region, if any
calc pbcztot   = 40 ! total width occupied by periodic components
calc pbczextot = 40 ! "" + excluded above/below
